<?xml version="1.0"?>
<package format="2">
  <name>px4_wall_ceiling_control</name>
  <version>0.1.0</version>
  <description>ROS1 PX4 ceiling and wall attachment control with guarded flight mode handover.</description>

  <maintainer email="cry@todo.todo">cry</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>message_generation</build_depend>

  <depend>geometry_msgs</depend>
  <depend>mavros_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>

  <exec_depend>message_runtime</exec_depend>
  <exec_depend>topic_tools</exec_depend>
  <!-- Optional at runtime: install python3-serial before enabling UART input. -->
  <exec_depend>python3-serial</exec_depend>

  <export/>
</package>
