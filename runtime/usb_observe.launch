<launch>
  <arg name="fcu_url" />
  <arg name="ceiling_serial_port" default="" />
  <arg name="front_serial_port" default="" />
  <include file="$(find mavros)/launch/px4.launch">
    <arg name="fcu_url" value="$(arg fcu_url)" />
    <arg name="gcs_url" value="" />
  </include>
  <rosparam command="load" file="$(find px4_wall_ceiling_control)/config/sensors.yaml" />
  <node if="$(eval arg('ceiling_serial_port') != '')" pkg="px4_wall_ceiling_control" type="lidar_distance_node.py" name="ceiling_lidar_node" output="screen" required="true">
    <param name="serial_port" value="$(arg ceiling_serial_port)" />
    <param name="range_topic" value="/sensor/ceiling/raw" />
    <param name="frame_id" value="ceiling_lidar_link" />
  </node>
  <node if="$(eval arg('front_serial_port') != '')" pkg="px4_wall_ceiling_control" type="lidar_distance_node.py" name="front_lidar_node" output="screen" required="true">
    <param name="serial_port" value="$(arg front_serial_port)" />
    <param name="range_topic" value="/sensor/front/raw" />
    <param name="frame_id" value="front_lidar_link" />
  </node>
  <node pkg="px4_wall_ceiling_control" type="sensor_range_manager_node.py" name="sensor_range_manager_node" output="screen" required="true" />
</launch>
