<launch>
  <arg name="com4_port" default="/dev/ttyUSB0" />
  <arg name="com5_port" default="/dev/ttyUSB1" />
  <node pkg="px4_wall_ceiling_control" type="lidar_distance_node.py" name="usb_com4_lidar" output="screen">
    <param name="serial_port" value="$(arg com4_port)" />
    <param name="baudrate" value="38400" />
    <param name="input_format" value="l1_ascii" />
    <param name="startup_command" value="iACM" />
    <param name="halt_on_shutdown" value="false" />
    <param name="min_range_m" value="0.03" />
    <param name="max_range_m" value="40.0" />
    <param name="range_topic" value="/sensor/com4/raw" />
    <param name="frame_id" value="com4_lidar_link" />
  </node>
  <node pkg="px4_wall_ceiling_control" type="lidar_distance_node.py" name="usb_com5_lidar" output="screen">
    <param name="serial_port" value="$(arg com5_port)" />
    <param name="baudrate" value="38400" />
    <param name="input_format" value="l1_ascii" />
    <param name="startup_command" value="iACM" />
    <param name="halt_on_shutdown" value="false" />
    <param name="min_range_m" value="0.03" />
    <param name="max_range_m" value="40.0" />
    <param name="range_topic" value="/sensor/com5/raw" />
    <param name="frame_id" value="com5_lidar_link" />
  </node>
  <node pkg="px4_wall_ceiling_control" type="sensor_range_manager_node.py" name="usb_sensor_range_manager" output="screen">
    <param name="ceiling_input_topic" value="/sensor/com4/raw" />
    <param name="front_input_topic" value="/sensor/com5/raw" />
    <param name="ceiling_output_topic" value="/sensor/com4/range" />
    <param name="front_output_topic" value="/sensor/com5/range" />
    <param name="health_topic" value="/sensor/usb_health" />
    <param name="input_timeout_s" value="0.6" />
    <param name="health_publish_rate_hz" value="10" />
  </node>
</launch>
