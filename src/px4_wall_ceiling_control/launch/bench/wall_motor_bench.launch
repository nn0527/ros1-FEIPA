<launch>
  <!--
    Propeller-free fixed-frame test through the production chain:
    real L1 -> range manager -> terminal operator -> wall decision -> output mux
    -> MAVROS -> PX4 -> ESC/motors. No mock topics or bench output adapter.
  -->
  <arg name="ceiling_serial_port"
       default="/dev/serial/by-path/pci-0000:04:00.3-usb-0:4.4:1.0-port0" />
  <arg name="front_serial_port"
       default="/dev/serial/by-path/pci-0000:04:00.3-usb-0:4.1:1.0-port0" />
  <arg name="output_enabled" default="false" />
  <arg name="flight_mode_enabled" default="false" />
  <arg name="estimator_timeout_s" default="1.5" />
  <arg name="state_timeout_s" default="1.5" />
  <arg name="max_thrust" default="0.45" />
  <arg name="hover_thrust" default="0.45" />
  <arg name="thrust_handover_ramp_s" default="1.0" />
  <!-- The fixed rig can have an arbitrary local-z origin. Keep live odometry
       for all other checks, but disable only the minimum-altitude gate. -->
  <arg name="require_min_altitude" default="false" />
  <arg name="min_altitude_m" default="-0.10" />

  <include file="$(find px4_wall_ceiling_control)/launch/system/attachment_system_mavros.launch">
    <arg name="ceiling_serial_port" value="$(arg ceiling_serial_port)" />
    <arg name="front_serial_port" value="$(arg front_serial_port)" />
    <arg name="ceiling_enabled" value="false" />
    <arg name="wall_enabled" value="true" />
    <arg name="output_enabled" value="$(arg output_enabled)" />
    <arg name="mechanism_output_enabled" value="false" />
    <arg name="operator_source" value="terminal" />
    <arg name="flight_mode_enabled" value="$(arg flight_mode_enabled)" />
    <arg name="flight_estimator_timeout_s" value="$(arg estimator_timeout_s)" />
    <arg name="flight_state_timeout_s" value="$(arg state_timeout_s)" />
    <arg name="wall_hold_time_s" value="0.0" />
    <arg name="wall_min_altitude_m" value="$(arg min_altitude_m)" />
    <arg name="wall_require_min_altitude"
         value="$(arg require_min_altitude)" />
    <arg name="output_max_thrust" value="$(arg max_thrust)" />
    <arg name="match_fcu_thrust_on_handover" value="true" />
    <arg name="thrust_handover_ramp_s" value="$(arg thrust_handover_ramp_s)" />
    <arg name="hover_thrust" value="$(arg hover_thrust)" />
  </include>
</launch>
