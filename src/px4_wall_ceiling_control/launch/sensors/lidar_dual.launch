<launch>
  <!-- Two physical L1 sensors -> validation/distribution -> consumers. -->
  <arg name="ceiling_serial_port"
       default="/dev/serial/by-path/pci-0000:02:00.0-usb-0:2.1:1.0-port0" />
  <arg name="front_serial_port" default="" />

  <rosparam command="load"
            file="$(find px4_wall_ceiling_control)/config/sensors.yaml" />
  <rosparam command="load"
            file="$(find px4_wall_ceiling_control)/config/operator.yaml" />

  <node pkg="px4_wall_ceiling_control" type="lidar_distance_node.py"
        name="ceiling_lidar_node" output="screen">
    <param name="serial_port" value="$(arg ceiling_serial_port)" />
    <param name="range_topic" value="/sensor/ceiling/raw" />
    <param name="frame_id" value="ceiling_lidar_link" />
  </node>

  <node pkg="px4_wall_ceiling_control" type="lidar_distance_node.py"
        name="front_lidar_node" output="screen">
    <param name="serial_port" value="$(arg front_serial_port)" />
    <param name="range_topic" value="/sensor/front/raw" />
    <param name="frame_id" value="front_lidar_link" />
  </node>

  <node pkg="px4_wall_ceiling_control" type="operator_gate_node.py"
        name="operator_gate_node" output="screen" />

  <node pkg="px4_wall_ceiling_control" type="sensor_range_manager_node.py"
        name="sensor_range_manager_node" output="screen" />
</launch>
