<launch>
  <!--
    Unified ceiling-attachment + wall-perch chain with one MAVROS output owner.
    MAVROS must be started separately. Real output defaults to disabled.
  -->
  <arg name="ceiling_serial_port"
       default="/dev/serial/by-path/pci-0000:04:00.3-usb-0:4.4:1.0-port0" />
  <arg name="front_serial_port"
       default="/dev/serial/by-path/pci-0000:04:00.3-usb-0:4.1:1.0-port0" />
  <arg name="ceiling_enabled" default="false" />
  <arg name="wall_enabled" default="false" />
  <arg name="output_enabled" default="false" />
  <arg name="mechanism_output_enabled" default="false" />
  <arg name="operator_source" default="rc" />
  <arg name="flight_mode_enabled" default="false" />
  <!-- PX4 ESTIMATOR_STATUS is normally emitted at 1 Hz. -->
  <arg name="flight_estimator_timeout_s" default="1.5" />
  <arg name="flight_state_timeout_s" default="1.5" />
  <arg name="require_mechanism_ack" default="true" />
  <arg name="wall_hold_time_s" default="0.0" />
  <!-- Runtime defaults preserve the flight configuration. Bench launches may
       lower the altitude gate and cap the final mux output without replacing
       any sensor, MAVROS, decision, operator or output node. -->
  <arg name="wall_min_altitude_m" default="0.30" />
  <arg name="wall_require_min_altitude" default="true" />
  <arg name="wall_bench_wait_for_ranges" default="false" />
  <arg name="wall_manual_approach" default="false" />
  <arg name="output_max_thrust" default="0.85" />
  <arg name="match_fcu_thrust_on_handover" default="false" />
  <arg name="thrust_handover_ramp_s" default="1.0" />
  <arg name="rc_assist_enabled" default="false" />
  <arg name="require_rc_center" default="false" />
  <arg name="rc_roll_channel_index" default="-1" />
  <arg name="rc_pitch_channel_index" default="-1" />
  <arg name="rc_throttle_channel_index" default="-1" />
  <arg name="rc_roll_reverse" default="false" />
  <arg name="rc_pitch_reverse" default="false" />
  <arg name="rc_pwm_low" default="1000" />
  <arg name="rc_pwm_center" default="1500" />
  <arg name="rc_pwm_high" default="2000" />
  <arg name="rc_center_tolerance_pwm" default="70" />
  <arg name="hover_thrust" default="0.45" />
  <!-- Passive recording is independent of all flight-control nodes. -->
  <arg name="record_logs" default="true" />
  <arg name="kill_guard_enabled" default="false" />
  <arg name="test_log_directory" default="$(env HOME)/wall_test_records" />
  <arg name="node_output" default="log" />

  <rosparam command="load"
            file="$(find px4_wall_ceiling_control)/config/sensors.yaml" />
  <rosparam command="load"
            file="$(find px4_wall_ceiling_control)/config/operator.yaml" />
  <rosparam command="load"
            file="$(find px4_wall_ceiling_control)/config/ceiling_attachment.yaml" />
  <rosparam command="load"
            file="$(find px4_wall_ceiling_control)/config/wall_perch.yaml" />
  <rosparam command="load"
            file="$(find px4_wall_ceiling_control)/config/attachment_output.yaml" />

  <node if="$(arg record_logs)" pkg="px4_wall_ceiling_control"
        type="attachment_flight_logger.py" name="attachment_flight_logger"
        output="screen" required="false">
    <param name="directory" value="$(arg test_log_directory)" />
  </node>

  <node pkg="px4_wall_ceiling_control" type="lidar_distance_node.py"
        name="ceiling_lidar_node" output="$(arg node_output)">
    <param name="serial_port" value="$(arg ceiling_serial_port)" />
    <param name="range_topic" value="/sensor/ceiling/raw" />
    <param name="frame_id" value="ceiling_lidar_link" />
  </node>

  <node if="$(eval arg('front_serial_port') != '')"
        pkg="px4_wall_ceiling_control" type="lidar_distance_node.py"
        name="front_lidar_node" output="$(arg node_output)">
    <param name="serial_port" value="$(arg front_serial_port)" />
    <param name="range_topic" value="/sensor/front/raw" />
    <param name="frame_id" value="front_lidar_link" />
  </node>

  <node if="$(eval arg('operator_source') == 'rc')"
        pkg="px4_wall_ceiling_control" type="operator_gate_node.py"
        name="operator_gate_node" output="$(arg node_output)" />
  <node if="$(eval arg('operator_source') == 'terminal')"
        pkg="px4_wall_ceiling_control" type="terminal_operator_node.py"
        name="terminal_operator_node" output="screen">
    <param name="kill_guard_enabled" value="$(arg kill_guard_enabled)" />
  </node>

  <node pkg="px4_wall_ceiling_control" type="flight_mode_manager_node.py"
        name="flight_mode_manager_node" output="$(arg node_output)">
    <param name="kill_guard_enabled" value="$(arg kill_guard_enabled)" />
    <param name="enabled" value="$(arg flight_mode_enabled)" />
    <param name="wall_bench_wait_for_ranges" value="$(arg wall_bench_wait_for_ranges)" />
    <param name="wall_manual_approach" value="$(arg wall_manual_approach)" />
    <param name="estimator_timeout_s"
           value="$(arg flight_estimator_timeout_s)" />
    <param name="state_timeout_s"
           value="$(arg flight_state_timeout_s)" />
    <param name="require_rc_center" value="$(arg require_rc_center)" />
    <param name="rc_roll_channel_index" value="$(arg rc_roll_channel_index)" />
    <param name="rc_pitch_channel_index" value="$(arg rc_pitch_channel_index)" />
    <param name="rc_throttle_channel_index" value="$(arg rc_throttle_channel_index)" />
    <param name="rc_pwm_center" value="$(arg rc_pwm_center)" />
    <param name="rc_center_tolerance_pwm" value="$(arg rc_center_tolerance_pwm)" />
  </node>

  <node pkg="px4_wall_ceiling_control" type="sensor_range_manager_node.py"
        name="sensor_range_manager_node" output="$(arg node_output)" />

  <node if="$(arg ceiling_enabled)"
        pkg="px4_wall_ceiling_control"
        type="ceiling_attachment_decision_node.py"
        name="ceiling_attachment_decision_node" output="$(arg node_output)">
    <param name="odom_topic" value="/mavros/local_position/odom" />
    <param name="require_mechanism_ack" value="$(arg require_mechanism_ack)" />
    <param name="hover_thrust" value="$(arg hover_thrust)" />
    <param name="state_timeout_s" value="$(arg flight_state_timeout_s)" />
  </node>

  <node if="$(arg wall_enabled)"
        pkg="px4_wall_ceiling_control" type="wall_perch_decision_node.py"
        name="wall_perch_decision_node" output="$(arg node_output)">
    <param name="kill_guard_enabled" value="$(arg kill_guard_enabled)" />
    <param name="decision_enabled" value="true" />
    <param name="manual_approach" value="$(arg wall_manual_approach)" />
    <param name="hold_time_s" value="$(arg wall_hold_time_s)" />
    <param name="min_altitude_m" value="$(arg wall_min_altitude_m)" />
    <param name="require_min_altitude"
           value="$(arg wall_require_min_altitude)" />
    <param name="bench_wait_for_ranges" value="$(arg wall_bench_wait_for_ranges)" />
    <param name="hover_thrust" value="$(arg hover_thrust)" />
    <param name="state_timeout_s" value="$(arg flight_state_timeout_s)" />
  </node>

  <node pkg="px4_wall_ceiling_control" type="attachment_output_mux_node.py"
        name="attachment_output_mux_node" output="$(arg node_output)">
    <param name="kill_guard_enabled" value="$(arg kill_guard_enabled)" />
    <param name="output_enabled" value="$(arg output_enabled)" />
    <param name="state_timeout_s" value="$(arg flight_state_timeout_s)" />
    <param name="ceiling_output_enabled" value="$(arg ceiling_enabled)" />
    <param name="wall_output_enabled" value="$(arg wall_enabled)" />
    <param name="rc_assist_enabled" value="$(arg rc_assist_enabled)" />
    <param name="rc_roll_channel_index" value="$(arg rc_roll_channel_index)" />
    <param name="rc_pitch_channel_index" value="$(arg rc_pitch_channel_index)" />
    <param name="rc_roll_reverse" value="$(arg rc_roll_reverse)" />
    <param name="rc_pitch_reverse" value="$(arg rc_pitch_reverse)" />
    <param name="rc_pwm_low" value="$(arg rc_pwm_low)" />
    <param name="rc_pwm_center" value="$(arg rc_pwm_center)" />
    <param name="rc_pwm_high" value="$(arg rc_pwm_high)" />
    <param name="hover_thrust" value="$(arg hover_thrust)" />
    <param name="max_thrust" value="$(arg output_max_thrust)" />
    <param name="match_fcu_thrust_on_handover"
           value="$(arg match_fcu_thrust_on_handover)" />
    <param name="thrust_handover_ramp_s"
           value="$(arg thrust_handover_ramp_s)" />
  </node>

  <node pkg="px4_wall_ceiling_control"
        type="attachment_mechanism_output_node.py"
        name="attachment_mechanism_output_node" output="$(arg node_output)">
    <param name="output_enabled" value="$(arg mechanism_output_enabled)" />
    <param name="require_ceiling_owner" value="true" />
  </node>
</launch>
