<launch>
  <arg name="rc_wall_toggle_enabled" default="true" />
  <arg name="rc_wall_channel_index" default="11" />
  <arg name="rc_mode_selector_enabled" default="true" />
  <arg name="rc_mode_channel_index" default="7" />
  <arg name="rc_mode_up_is_high" default="false" />
  <!-- Real MAVROS output: use only after sensor, frame and thrust calibration. -->
  <arg name="ceiling_serial_port" default="/dev/serial/by-path/pci-0000:04:00.3-usb-0:4.4:1.0-port0" />
  <arg name="front_serial_port"
       default="/dev/serial/by-path/pci-0000:04:00.3-usb-0:4.1:1.0-port0" />
  <arg name="flight_enabled" default="false" />
  <arg name="rc_assist_enabled" default="$(arg flight_enabled)" />
  <arg name="rc_roll_channel_index" default="-1" />
  <arg name="rc_pitch_channel_index" default="-1" />
  <arg name="rc_throttle_channel_index" default="-1" />
  <arg name="rc_roll_reverse" default="false" />
  <arg name="rc_pitch_reverse" default="false" />
  <arg name="rc_pwm_low" default="1000" />
  <arg name="rc_pwm_center" default="1500" />
  <arg name="rc_pwm_high" default="2000" />
  <arg name="rc_center_tolerance_pwm" default="70" />
  <arg name="hover_thrust" default="0.49" />
  <arg name="record_logs" default="true" />
  <arg name="test_log_directory" default="$(env HOME)/wall_test_records" />
  <include file="$(find px4_wall_ceiling_control)/launch/system/attachment_system_mavros.launch">
    <arg name="record_logs" value="$(arg record_logs)" />
    <arg name="test_log_directory" value="$(arg test_log_directory)" />
    <arg name="ceiling_serial_port" value="$(arg ceiling_serial_port)" />
    <arg name="front_serial_port" value="$(arg front_serial_port)" />
    <arg name="operator_source" value="terminal" />
    <arg name="rc_wall_toggle_enabled" value="$(arg rc_wall_toggle_enabled)" />
    <arg name="rc_wall_channel_index" value="$(arg rc_wall_channel_index)" />
    <arg name="rc_mode_selector_enabled" value="$(arg rc_mode_selector_enabled)" />
    <arg name="rc_mode_channel_index" value="$(arg rc_mode_channel_index)" />
    <arg name="rc_mode_up_is_high" value="$(arg rc_mode_up_is_high)" />
    <arg name="flight_mode_enabled" value="$(arg flight_enabled)" />
    <arg name="ceiling_enabled" value="true" />
    <arg name="wall_enabled" value="true" />
    <arg name="output_enabled" value="$(arg flight_enabled)" />
    <arg name="mechanism_output_enabled" value="false" />
    <arg name="require_mechanism_ack" value="false" />
    <arg name="wall_hold_time_s" value="0.0" />
    <arg name="rc_assist_enabled" value="$(arg rc_assist_enabled)" />
    <arg name="require_rc_center" value="$(arg flight_enabled)" />
    <arg name="rc_roll_channel_index" value="$(arg rc_roll_channel_index)" />
    <arg name="rc_pitch_channel_index" value="$(arg rc_pitch_channel_index)" />
    <arg name="rc_throttle_channel_index" value="$(arg rc_throttle_channel_index)" />
    <arg name="rc_roll_reverse" value="$(arg rc_roll_reverse)" />
    <arg name="rc_pitch_reverse" value="$(arg rc_pitch_reverse)" />
    <arg name="rc_pwm_low" value="$(arg rc_pwm_low)" />
    <arg name="rc_pwm_center" value="$(arg rc_pwm_center)" />
    <arg name="rc_pwm_high" value="$(arg rc_pwm_high)" />
    <arg name="rc_center_tolerance_pwm" value="$(arg rc_center_tolerance_pwm)" />
    <arg name="hover_thrust" value="$(arg hover_thrust)" />
  </include>
</launch>
