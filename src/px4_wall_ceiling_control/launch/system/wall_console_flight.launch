<launch>
  <!-- Dedicated ALTCTL -> wall-only entry. Calibrated bounded roll/yaw correction; no auto takeoff. -->
  <arg name="ceiling_serial_port" default="/dev/ttyUSB1" />
  <arg name="front_serial_port" default="/dev/ttyUSB2" />
  <arg name="hover_thrust" default="0.45" />
  <arg name="restrained_bench" default="false" />
  <include file="$(find px4_wall_ceiling_control)/launch/system/attachment_system_mavros.launch">
    <arg name="ceiling_serial_port" value="$(arg ceiling_serial_port)" />
    <arg name="front_serial_port" value="$(arg front_serial_port)" />
    <arg name="operator_source" value="terminal" />
    <arg name="kill_guard_enabled" value="true" />
    <arg name="flight_mode_enabled" value="true" />
    <arg name="wall_enabled" value="true" />
    <arg name="wall_manual_approach" value="true" />
    <arg name="wall_flip_thrust_follow_tilt" value="true" />
    <arg name="match_fcu_thrust_on_handover" value="true" />
    <arg name="thrust_handover_ramp_s" value="1.0" />
    <!-- Measured FCU target stream is 4 Hz despite the requested 10 Hz. -->
    <arg name="fcu_target_timeout_s" value="0.35" />
    <arg name="ceiling_enabled" value="false" />
    <arg name="output_enabled" value="true" />
    <arg name="mechanism_output_enabled" value="false" />
    <arg name="require_mechanism_ack" value="false" />
    <arg name="wall_hold_time_s" value="0.0" />
    <arg name="rc_assist_enabled" value="true" />
    <arg name="rc_roll_yaw_enabled" value="true" />
    <arg name="recovery_attitude_limits_enabled" value="true" />
    <arg name="require_rc_center" value="false" />
    <arg name="hover_thrust" value="$(arg hover_thrust)" />
    <arg name="wall_require_min_altitude" value="$(eval not arg('restrained_bench'))" />
    <arg name="wall_bench_wait_for_ranges" value="$(arg restrained_bench)" />
  </include>
</launch>
