<launch>
  <arg name="rc_wall_toggle_enabled" default="true" />
  <arg name="rc_wall_channel_index" default="11" />
  <arg name="rc_mode_selector_enabled" default="true" />
  <arg name="rc_mode_channel_index" default="7" />
  <arg name="rc_mode_up_is_high" default="false" />
  <!-- POSCTL entry: wall uses calibrated roll/yaw; ceiling uses roll/pitch. No auto takeoff. -->
  <arg name="ceiling_serial_port" default="/dev/ttyUSB1" />
  <arg name="front_serial_port" default="/dev/ttyUSB2" />
  <arg name="hover_thrust" default="0.49" />
  <arg name="preflip_right_roll_deg" default="1.7" />
  <arg name="restrained_bench" default="false" />
  <arg name="detach_range_height_enabled" default="true" />
  <arg name="detach_range_entry_tilt_deg" default="" />
  <arg name="detach_range_operating_tilt_deg" default="" />
  <arg name="detach_range_min_distance_m" default="" />
  <arg name="detach_range_max_distance_m" default="" />
  <arg name="detach_range_geometry_confirmed" default="" />
  <arg name="wall_sensor_fusion_enabled" default="true" />
  <arg name="wall_sensor_fusion_restore_tilt_deg" default="80.0" />
  <include file="$(find px4_wall_ceiling_control)/launch/system/attachment_system_mavros.launch">
    <arg name="ceiling_serial_port" value="$(arg ceiling_serial_port)" />
    <arg name="front_serial_port" value="$(arg front_serial_port)" />
    <arg name="operator_source" value="terminal" />
    <arg name="rc_wall_toggle_enabled" value="$(arg rc_wall_toggle_enabled)" />
    <arg name="rc_wall_channel_index" value="$(arg rc_wall_channel_index)" />
    <arg name="rc_mode_selector_enabled" value="$(arg rc_mode_selector_enabled)" />
    <arg name="rc_mode_channel_index" value="$(arg rc_mode_channel_index)" />
    <arg name="rc_mode_up_is_high" value="$(arg rc_mode_up_is_high)" />
    <arg name="kill_guard_enabled" value="true" />
    <arg name="flight_mode_enabled" value="true" />
    <arg name="wall_enabled" value="true" />
    <arg name="wall_sensor_fusion_enabled" value="$(arg wall_sensor_fusion_enabled)" />
    <arg name="wall_sensor_fusion_restore_tilt_deg" value="$(arg wall_sensor_fusion_restore_tilt_deg)" />
    <arg name="wall_manual_approach" value="false" />
    <arg name="wall_auto_approach" value="true" />
    <arg name="wall_flip_thrust_follow_tilt" value="true" />
    <arg name="match_fcu_thrust_on_handover" value="true" />
    <arg name="thrust_handover_ramp_s" value="1.0" />
    <!-- Measured FCU target stream is 4 Hz despite the requested 10 Hz. -->
    <arg name="fcu_target_timeout_s" value="0.35" />
    <arg name="ceiling_enabled" value="true" />
    <arg name="output_enabled" value="true" />
    <arg name="mechanism_output_enabled" value="false" />
    <arg name="require_mechanism_ack" value="false" />
    <arg name="wall_hold_time_s" value="0.0" />
    <arg name="rc_assist_enabled" value="true" />
    <arg name="rc_roll_yaw_enabled" value="true" />
    <arg name="rc_ceiling_roll_pitch_enabled" value="true" />
    <arg name="preflip_right_roll_deg" value="$(arg preflip_right_roll_deg)" />
    <arg name="recovery_attitude_limits_enabled" value="true" />
    <arg name="require_rc_center" value="false" />
    <arg name="hover_thrust" value="$(arg hover_thrust)" />
    <arg name="wall_require_min_altitude" value="$(eval not arg('restrained_bench'))" />
    <arg name="wall_bench_wait_for_ranges" value="$(arg restrained_bench)" />
  </include>
  <param name="/wall_perch_decision_node/detach_range_height_enabled" value="$(eval arg('detach_range_height_enabled') and not arg('restrained_bench'))" />
  <param if="$(eval arg('detach_range_entry_tilt_deg') != '')" name="/wall_perch_decision_node/detach_range_entry_tilt_deg" value="$(arg detach_range_entry_tilt_deg)" />
  <param if="$(eval arg('detach_range_operating_tilt_deg') != '')" name="/wall_perch_decision_node/detach_range_operating_tilt_deg" value="$(arg detach_range_operating_tilt_deg)" />
  <param if="$(eval arg('detach_range_min_distance_m') != '')" name="/wall_perch_decision_node/detach_range_min_distance_m" value="$(arg detach_range_min_distance_m)" />
  <param if="$(eval arg('detach_range_max_distance_m') != '')" name="/wall_perch_decision_node/detach_range_max_distance_m" value="$(arg detach_range_max_distance_m)" />
  <param if="$(eval arg('detach_range_geometry_confirmed') != '')" name="/wall_perch_decision_node/detach_range_geometry_confirmed" value="$(arg detach_range_geometry_confirmed)" />
  <param name="/ceiling_attachment_decision_node/detach_fused_height_enabled" value="true" />
  <param name="/ceiling_attachment_decision_node/detach_baro_height_enabled" value="false" />
  <param name="/flight_mode_manager_node/ceiling_height_handover_enabled" value="true" />
  <param name="/attachment/front_sensor_masked" value="false" />
  <param name="/flight_mode_manager_node/ceiling_distance_gate_enabled" value="true" />
  <param name="/flight_mode_manager_node/wall_pilot_mode" value="POSCTL" />
  <param name="/wall_perch_decision_node/flip_vertical_support_enabled" value="true" />
  <param name="/wall_perch_decision_node/flip_support_fade_start_deg" value="20.0" />
  <param name="/wall_perch_decision_node/flip_support_fade_end_deg" value="60.0" />
  <param name="/wall_perch_decision_node/flip_thrust_slew_per_s" value="0.50" />
  <param name="/wall_perch_decision_node/horizontal_velocity_enabled" value="true" />
  <param name="/wall_perch_decision_node/horizontal_approach_speed_mps" value="0.10" />
  <param name="/ceiling_attachment_decision_node/console_contact_profile" value="true" />
  <param name="/ceiling_attachment_decision_node/activation_distance_m" value="1.0" />
  <param name="/ceiling_attachment_decision_node/wall_contact_distance_m" value="0.067" />
  <param name="/ceiling_attachment_decision_node/surface_hold_thrust" value="0.50" />
  <param name="/ceiling_attachment_decision_node/approach_settle_time_s" value="0.0" />
  <param name="/ceiling_attachment_decision_node/approach_timeout_s" value="12.0" />
  <param name="/ceiling_attachment_decision_node/contact_distance_m" value="0.056" />
  <param name="/ceiling_attachment_decision_node/target_compression_m" value="0.006" />
  <param name="/ceiling_attachment_decision_node/detach_drop_m" value="0.50" />
  <param name="/ceiling_attachment_decision_node/detach_safe_distance_m" value="0.10" />
  <param name="/ceiling_attachment_decision_node/detach_timeout_s" value="20.0" />
  <param name="/ceiling_attachment_decision_node/recovery_hover_time_s" value="0.50" />
  <!-- Passive independent ceiling capture, identical format to wall records. -->
  <node pkg="px4_wall_ceiling_control" type="attachment_flight_logger.py"
        name="ceiling_flight_logger" output="screen">
    <param name="directory" value="/root/ceiling_test" />
  </node>
</launch>
